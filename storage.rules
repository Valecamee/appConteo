// Firebase Storage Rules para desarrollo
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura y escritura para proyectos
    match /projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Permitir lectura y escritura para accesos
    match /projects/{projectId}/corners/{cornerId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regla general para desarrollo (más permisiva)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}



